     set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} --use-port=sdl2 --use-port=zlib -fwasm-exceptions")
     #find_package(Boost ${MINIMUM_BOOST_VERSION} REQUIRED )
