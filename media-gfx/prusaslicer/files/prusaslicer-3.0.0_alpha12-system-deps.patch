Build against Gentoo's system libraries instead of the upstream deps tree.

- Tracy: only the headers are needed with SLIC3R_ENABLE_PROFILING=OFF.
- wxGTK is built with autotools and ships no CMake config, use wx-config.
- Gentoo's zstd has no CMake config; a shared blosc does not need it.
- app-arch/libdeflate is only built as a shared library (libdeflate_shared).
- webkit2gtk-4.0 (libsoup2) must not be mixed with wxGTK's webkit2gtk-4.1.
- prusa-fdm-mixer is built from bundled_deps/ (unpacked by the ebuild).
- nlohmann_json 3.12.0 is used from bundled_deps/ with the std::optional fix
  and implicit conversions disabled, like upstream deps/+json. libslic3r
  includes it too but did not link the target.
- The glfw and SDL2 imgui backends are not linked by anything on Linux.

diff --git a/bundled_deps/CMakeLists.txt b/bundled_deps/CMakeLists.txt
index de8003c..6d6b7ee 100644
--- a/bundled_deps/CMakeLists.txt
+++ b/bundled_deps/CMakeLists.txt
@@ -10,6 +10,16 @@ add_subdirectory(hints)
 add_subdirectory(libnest2d)
 add_subdirectory(clipper)
 
+add_library(prusa_fdm_mixer STATIC prusa_fdm_mixer/prusa_fdm_mixer/prusa_fdm_mixer.cpp)
+add_library(prusa_fdm_mixer::prusa_fdm_mixer ALIAS prusa_fdm_mixer)
+target_include_directories(prusa_fdm_mixer PUBLIC prusa_fdm_mixer)
+
+# nlohmann_json 3.12.0 with the std::optional fix, configured like upstream deps/+json
+set(JSON_BuildTests OFF)
+set(JSON_ImplicitConversions OFF)
+set(JSON_Install OFF)
+add_subdirectory(nlohmann_json EXCLUDE_FROM_ALL)
+
 add_library(semver STATIC
     semver/semver.c
     semver/semver.h
